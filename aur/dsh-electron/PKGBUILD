# ============================================================================
#  dsh-electron —— 官方 DSH WebUI 的稳定 Linux 承载平台
#
#  为什么需要它
#    官方 DeepSeek Harness Desktop 只有 Windows/macOS 版本；Linux 上此前用
#    Chrome PWA 承载官方 WebUI，存在共享日常浏览器/GPU 进程、无 supervisor、
#    DSH 预览版更新易把页面宿主一起带崩等问题。本包提供 Linux 侧宿主：
#      · 官方 WebUI 零修改（不加前端补丁）
#      · supervisor 管理 dsh web 子进程与 Electron GUI，生命周期解耦
#      · 新版 DSH 启动失败时自动回退内部 known-good runtime
#      · GUI 关闭仅隐藏到托盘，DSH 任务继续后台运行
#
#  单一真理源
#    GitHub: https://github.com/Moritz230127/dsh-electron
#    本 PKGBUILD 从 release tag tarball 源码构建完整包（npm/electron-builder），
#    并安装 systemd 用户单元、桌面入口、官方 DSH 托盘图标与文档。
#
#  登记
#    ADR-0011 §B8；完整决策见 ADR-0036。
#
#  维护者/联系
#    Moritz001 <moritz001@163.com>
# ============================================================================

pkgname=dsh-electron
pkgver=0.1.3
pkgrel=1
pkgdesc='Unofficial self-healing Linux host for the official DeepSeek Harness Web UI'
arch=('x86_64')
url='https://github.com/Moritz230127/dsh-electron'
license=('MIT')
depends=(
  'nodejs'
  'c-ares' 'libgcc' 'glibc' 'gtk3' 'libevent' 'libffi' 'libpulse' 'nss'
  'zlib' 'fontconfig' 'brotli' 'libjpeg-turbo' 'flac' 'libdrm' 'libxml2'
  'minizip' 'opus' 'libxslt' 'harfbuzz' 'freetype2' 'xdg-utils'
)
makedepends=('npm')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Moritz230127/dsh-electron/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2b4e798460c94509fbdf1989f80c7fb5d53dfae4b9a88973bde810fa99abd4f4')
options=('!strip' '!debug')

build() {
  cd "$pkgname-$pkgver"
  export ELECTRON_MIRROR="${ELECTRON_MIRROR:-https://npmmirror.com/mirrors/electron/}"
  npm ci --foreground-scripts --no-audit --no-fund
  npm run package:dir
}

check() {
  cd "$pkgname-$pkgver"
  test -x 'dist/linux-unpacked/dsh-electron'
  test -f 'dist/linux-unpacked/resources/host/supervisor.js'
  test -f 'dist/linux-unpacked/resources/main/runtime/harness-runtime.js'
}

package() {
  cd "$pkgname-$pkgver"

  install -d "$pkgdir/opt/DSH Electron"
  cp -a dist/linux-unpacked/. "$pkgdir/opt/DSH Electron/"

  install -Dm644 packaging/dsh-host.service \
    "$pkgdir/usr/lib/systemd/user/dsh-host.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../dsh-host.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/dsh-host.service"

  install -Dm755 scripts/dsh-host-open "$pkgdir/usr/bin/dsh-host-open"

  install -Dm644 packaging/deepseek-harness.desktop \
    "$pkgdir/usr/share/applications/deepseek-harness.desktop"
  # White whale launcher icon at every launcher size (all icons white).
  install -Dm644 packaging/icon-white.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/deepseek-harness.png"
  for size in 16 24 32 48 64 128; do
    install -Dm644 "packaging/icon-white-${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/deepseek-harness.png"
  done

  install -Dm644 packaging/niri-window-rule.kdl \
    "$pkgdir/usr/share/doc/$pkgname/niri-window-rule.kdl"
  install -Dm644 docs/V0.2-HANDOFF.md \
    "$pkgdir/usr/share/doc/$pkgname/V0.2-HANDOFF.md"
  install -Dm644 docs/DEPLOY.md \
    "$pkgdir/usr/share/doc/$pkgname/DEPLOY.md"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
